<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for https://ignitionpay.com/... (issue #677). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ignitionpay.com</string>
		<string>applinks:www.ignitionpay.com</string>
	</array>
</dict>
</plist>
